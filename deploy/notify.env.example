# Notification config for ghost-cm-sync alerts.
# Install path: /etc/ghost-cm-sync/notify.env (root:root, mode 600)

# Slack incoming webhook (used by deploy/slack-alert-failure.sh on systemd unit failure).
# Create one: https://api.slack.com/apps → Your App → Incoming Webhooks → Add to channel.
# Format: https://hooks.slack.com/services/<team-id>/<bot-id>/<token>
SLACK_WEBHOOK_URL=

# Healthchecks.io ping URL (used by deploy/activity-sentinel.py).
# Set up: https://healthchecks.io → Add Check → Period 12h, Grace 12h → integrate with Slack.
# Format: https://hc-ping.com/<uuid>
HC_ACTIVITY_URL=
