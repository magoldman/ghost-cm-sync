# Slack incoming webhook for systemd failure alerts.
# Create one: https://api.slack.com/apps → Your App → Incoming Webhooks → Add to channel.
# Install path: /etc/ghost-cm-sync/notify.env (root:root, mode 600)
# Format: https://hooks.slack.com/services/<team-id>/<bot-id>/<token>
SLACK_WEBHOOK_URL=
